# Copy to .env in the repository root. Never commit the filled file.
# openai (default) or anthropic. Only the selected provider's key is required.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Anthropic-compatible endpoint, e.g. a gateway base URL. Empty uses the SDK default.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_USER_UIDS=
ALLOWED_ORIGINS=http://localhost:3000
MAX_OUTPUT_TOKENS=4000
DAILY_REQUEST_LIMIT=30
