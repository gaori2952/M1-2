{
  "name": "m1-2-content-studio",
  "private": true,
  "scripts": {
    "build": "node frontend/build-config.mjs",
    "test:e2e": "node tests/e2e/growth.mjs",
    "format:check": "prettier --check frontend/*.js frontend/*.mjs frontend/*.html frontend/*.css tests/e2e/*.mjs",
    "test:build": "node --test tests/build.test.mjs",
    "test:durability": "node tests/e2e/durability.mjs",
    "test:editor": "node tests/e2e/editor.mjs",
    "test:editor-regressions": "node tests/e2e/editor-regressions.mjs",
    "test:image-review": "node tests/e2e/image-review.mjs",
    "test:image-review-regressions": "node tests/e2e/image-review-regressions.mjs",
    "test:growth": "node tests/e2e/growth.mjs",
    "test:growth-regressions": "node tests/e2e/growth-regressions.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "prettier": "^3.6.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "fflate": "0.8.2",
    "mathjax": "3.2.2"
  }
}
